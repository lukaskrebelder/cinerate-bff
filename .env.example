PORT=4000
# URL des Kern-Backends, das dieses BFF aufruft
BACKEND_URL=http://localhost:3000
# URL der SPA, fuer CORS. Lokal kann das leer bleiben.
SPA_URL=
# Interner Schluessel: das Backend nimmt nur Anfragen mit diesem Wert im Header X-Internal-Key an.
# Lokal leer lassen, wenn das lokale Backend keinen Schluessel erwartet.
INTERNAL_API_KEY=
